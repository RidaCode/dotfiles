# Smooth cursor movement (Neovide-like)
custom-shader = shaders/ghostty/cursor_warp.glsl

# Ripple effect on cursor shape changes
custom-shader = shaders/ghostty/ripple_cursor.glsl

# Keep animations running
custom-shader-animation = always

adjust-cursor-thickness = 5

# Cursor Color
cursor-color = #FF7700

# Theme - Match Neovim
theme = tokyonight_night
background-opacity = 1

# Font
font-family = JetBrainsMono Nerd Font
font-size = 13

# Save windows panes size ect..
window-save-state = always

# Forward Super+J/K to terminal applications
keybind = super+j=csi:106;9u
keybind = super+k=csi:107;9u
